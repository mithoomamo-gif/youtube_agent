# ─── YouTube Agent — development environment template ───────────────────────
# Copy to ".env" in the repo root and fill in YOUR OWN keys for local dev
# runs (loaded by app.providers.secrets_env.EnvSecretProvider).
# ".env" is git-ignored — NEVER commit real keys.
# Production does NOT use this file: keys live in the OS keyring
# (Windows Credential Manager) via Settings → Providers.
# All values are intentionally EMPTY below.

# ─── LLM providers (script / research / metadata generation) ───────────────
# Google Gemini API key — unlocks the Gemini LLM adapters (all tiers).
GEMINI_API_KEY=
# OpenAI API key — unlocks the OpenAI LLM adapters and the OpenAI TTS option.
OPENAI_API_KEY=
# Anthropic API key — unlocks the Claude LLM adapters (incl. T3 final pass).
ANTHROPIC_API_KEY=
# Google API key — unlocks Google Cloud TTS (google_tts); also accepted as a fallback alias for GEMINI_API_KEY.
GOOGLE_API_KEY=

# ─── TTS / voice providers ───────────────────────────────────────────────────
# ElevenLabs API key — unlocks ElevenLabs text-to-speech voices.
ELEVENLABS_API_KEY=
# Azure AI Speech key — unlocks Azure Speech TTS (same voices as edge-tts).
AZURE_SPEECH_KEY=
# Azure Speech region for the key above, e.g. eastus (config, not a secret; the adapter defaults to eastus).
AZURE_SPEECH_REGION=

# ─── Stock media providers ───────────────────────────────────────────────────
# Pixabay API key — unlocks Pixabay stock video/photo search (shipping default source).
PIXABAY_API_KEY=
# Pexels API key — unlocks Pexels stock video/photo search (co-primary source).
PEXELS_API_KEY=

# ─── Image generation ────────────────────────────────────────────────────────
# Black Forest Labs API key — unlocks the FLUX API adapter (overflow + premium hero/thumbnail images).
BFL_API_KEY=

# ─── YouTube (OAuth desktop-app credentials, Google Cloud Console) ──────────
# YouTube OAuth client ID — unlocks connecting a YouTube channel (uploads use OAuth, never an API key).
YOUTUBE_CLIENT_ID=
# YouTube OAuth client secret — pairs with the client ID above for the channel connect / token-refresh flow.
YOUTUBE_CLIENT_SECRET=

# ─── Dev-only options (not secrets) ──────────────────────────────────────────
# Secret backend for dev runs: leave unset for the production keyring default; set to "env" to use this .env file via create_secret_provider().
# YTA_SECRET_BACKEND=
