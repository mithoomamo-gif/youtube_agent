{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*; style-src 'self' 'unsafe-inline'"
    },
    "windows": [
      {
        "center": true,
        "decorations": false,
        "height": 900,
        "label": "main",
        "minHeight": 700,
        "minWidth": 1100,
        "title": "YouTube Agent",
        "visible": false,
        "width": 1440
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "externalBin": [
      "binaries/agent-backend"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "binaries/agent-backend/": "agent-backend/"
    },
    "targets": [
      "nsis"
    ],
    "windows": {
      "minimumWebview2Version": "110.0.0.0",
      "nsis": {
        "compression": "lzma",
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "languages": [
          "English"
        ],
        "startMenuFolder": "YouTube Agent",
        "uninstallerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  },
  "identifier": "com.youtubeagent.app",
  "plugins": {
    "updater": {
      "endpoints": [
        "https://updates.youtubeagent.app/releases/{{target}}/{{arch}}/{{current_version}}/latest.json",
        "https://github.com/youtube-agent/youtube-agent/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI2ODkxQjhCNkMzMDQ5NzMKUldSelNUQnNpeHVKdHB1VStFYnJ3Vm5GQ1RNZEVqWEhmdjNPQ2NXNitHOXdydmxsTnpMVWhFMS8K",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "productName": "YouTube Agent",
  "version": "../package.json"
}
